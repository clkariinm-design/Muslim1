<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep personal notes, bookmarks, and cached audio local by default -->
        <exclude domain="database" path="nuur_quran.db" />
        <exclude domain="file" path="audio" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="audio" />
    </device-transfer>
</data-extraction-rules>
